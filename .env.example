# Template only. Keep real values exclusively in .env.local and Vercel's secret environment variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use only a server-side Supabase service_role key. Never use an anon/publishable key here.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key
APP_ORIGIN=http://localhost:3000
# Generate each value independently. AES keys are 32 random bytes, encoded as base64.
SSN_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
SSN_ENCRYPTION_KEY_ID=ssn-v1
RATE_LIMIT_HMAC_KEY=replace-with-independent-random-secret-at-least-32-characters
SUBMISSION_HMAC_KEY=replace-with-independent-random-secret-at-least-32-characters
ADMIN_SESSION_KEY_BASE64=replace-with-independent-32-byte-base64-key
# Private ClamAV daemon address for the trusted scanner worker only. Never expose it publicly.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
SCAN_BATCH_SIZE=10
SCAN_INTERVAL_MS=60000
